{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eliminators-gambit",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eliminators-gambit",
      "database_id": "a5afd436-1b28-4e34-92bd-1323b6c8122c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  // Served only on the custom domain; the *.workers.dev URL stays off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.eliminatorsgambit.com", "custom_domain": true }]
}
